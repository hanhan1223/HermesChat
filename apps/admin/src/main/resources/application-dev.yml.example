# 本地/远程环境私有配置模板 — 复制为 application-dev.yml 后填写，勿提交真实密钥
server:
  port: 8080
  servlet:
    context-path: /admin

spring:
  datasource:
    # 远程 PostgreSQL 示例（按实际环境修改）
    url: jdbc:postgresql://YOUR_DB_HOST:5432/YOUR_DB_NAME
    username: YOUR_DB_USER
    password: YOUR_DB_PASSWORD
  data:
    redis:
      host: YOUR_REDIS_HOST
      port: 6379
      password: YOUR_REDIS_PASSWORD

jwt:
  secret: change-me-in-production-hermes-jwt-secret-key
  expiration: 7776000000
