# 环境变量配置 (API 服务)

# 数据库
DATABASE_URL="postgresql://hermes:hermes_password@localhost:5432/hermes_chat?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 服务端口
PORT=4000

# MinIO / S3
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="hermes-chat"

# AI Provider API Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# 日志级别
LOG_LEVEL="info"

# CORS
CORS_ORIGIN="http://localhost:3000"
