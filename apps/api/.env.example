# ===== Harness API (NestJS) =====
NODE_ENV=development
PORT=4000

# 数据库
DATABASE_URL=postgresql://hermes:hermes_password_2026@localhost:5432/hermes_chat?schema=public

# Redis
REDIS_URL=redis://:hermes_redis_2026@localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=hermes
MINIO_SECRET_KEY=hermes_minio_2026
MINIO_BUCKET=hermes-chat

# JWT - 3 个月免登录
JWT_SECRET=change-me-in-production-hermes-jwt-secret-key
JWT_EXPIRES_IN=90d

# 免登录免费对话条数
GUEST_FREE_MESSAGES=10

# Agent
AGENT_MAX_STEPS=10

# CORS
CORS_ORIGINS=http://localhost:3000

# 分享链接
WEB_BASE_URL=http://localhost:3000
SHORT_LINK_BASE_URL=http://localhost:3000/s/

# 管理后台地址
ADMIN_API_URL=http://localhost:8080

# RAGFlow 知识库引擎
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=your-ragflow-api-key-here

# ===== 搜索服务（可选；优先在管理后台「搜索服务」配置，环境变量作缺省回退）=====
# Tavily 联网搜索（web_search / google_search 回退）https://tavily.com
TAVILY_API_KEY=
# SerpAPI：Google / Google Scholar（google_search、scholar_search source=google_scholar）
SERPAPI_API_KEY=
# NCBI：PubMed 提高 RPS（不配也可用，限流更严）
NCBI_API_KEY=
# Semantic Scholar 可选 API Key
SEMANTIC_SCHOLAR_API_KEY=